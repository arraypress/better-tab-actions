{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "__MSG_extShortName__",
  "version": "1.0.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "150",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "__MSG_toolbarTitle__",
    "default_icon": {
      "16": "icons/toolbar/light-16.png",
      "32": "icons/toolbar/light-32.png",
      "48": "icons/toolbar/light-48.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": ["contextMenus", "tabs", "tabGroups", "storage", "offscreen", "alarms"],
  "commands": {
    "switch-last-tab": { "description": "__MSG_actionSwitchLastTab__" },
    "close-tabs-to-left": { "description": "__MSG_actionCloseTabsToLeft__" },
    "close-site-tabs": { "description": "__MSG_actionCloseSiteTabs__" },
    "close-other-site-tabs": { "description": "__MSG_actionCloseOtherSiteTabs__" },
    "close-duplicate-tabs": { "description": "__MSG_actionCloseDuplicateTabs__" },
    "close-inactive-tabs": { "description": "__MSG_actionCloseInactiveTabs__" },
    "reopen-closed-tabs": { "description": "__MSG_actionReopenClosedTabs__" },
    "sort-tabs-by-site": { "description": "__MSG_actionSortTabsBySite__" },
    "mute-other-tabs": { "description": "__MSG_actionMuteOtherTabs__" },
    "open-workspace": { "description": "__MSG_actionOpenWorkspace__" },
    "save-window-as-group": { "description": "__MSG_actionSaveWindowAsGroup__" },
    "close-window-keep-group": { "description": "__MSG_actionCloseWindowKeepGroup__" },
    "save-workspace": { "description": "__MSG_actionSaveWorkspace__" },
    "save-window-workspace": { "description": "__MSG_actionSaveWindowWorkspace__" }
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  }
}
