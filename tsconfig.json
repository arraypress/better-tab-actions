{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "target": "ES2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["chrome", "node"],
    "skipLibCheck": true
  },
  "include": ["extension/**/*.js", "test/**/*.js", "test/**/*.mjs", "scripts/**/*.mjs", "store/**/*.mjs", "docs/**/*.js", "eslint.config.js"],
  "exclude": ["extension/vendor/**"]
}
